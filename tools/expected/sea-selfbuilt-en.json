    "last_name": "basics.lastName",
    "email": "contact.email",
    "phone": "contact.phone",
    "location": "contact.city",
    "school_1": "education.0.school",
    "major_1": "education.0.major",
    "start_1": "education.0.enrollDate",
    "end_1": "education.0.gradDate",
    "cgpa_1": "education.0.gpa",
    "school_2": "education.1.school",
    "major_2": "education.1.major",
